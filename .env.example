# ==============================================================================
# ARGUS MINECRAFT BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Canonical Owner Username (Immutable Tier-4 Owner)
OWNER_USERNAME=ShadowPace

# Minecraft Server Connection
MC_HOST=localhost
MC_PORT=25565
# Set to 'auto' to let Mineflayer ping and match server version, or specify exact version (e.g. 1.19.4, 1.20.1, 1.20.4, 1.21)
MC_VERSION=auto
# Keep-alive timeout in ms (default 60000ms; increase for high-latency or free-tier hosting like Aternos)
CHECK_TIMEOUT_INTERVAL=60000

# API Server & WebSocket Telemetry Port
API_PORT=3000

# Optional MongoDB Connection String (Falls back to local persistent JSON state)
MONGODB_URI=mongodb://localhost:27017/argus

# Web Dashboard Authentication
DASHBOARD_PASSWORD=replace_with_a_unique_12_character_or_longer_password
DASHBOARD_SESSION_SECRET=replace_with_a_unique_32_character_or_longer_random_session_secret
